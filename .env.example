# Claude API — https://console.anthropic.com/ (for the LLM recipe-parse fallback)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Kroger developer app — https://developer.kroger.com/
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=
# Must exactly match the redirect URI registered on the Kroger developer portal
KROGER_REDIRECT_URI=http://localhost:3000/

# Local dev only (ignored by Netlify)
PORT=3000
